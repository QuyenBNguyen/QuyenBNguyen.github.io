---
import {SITE_AUTHOR} from '../consts';
---
<section id="about">
    <h2>About Me</h2>
    <div class="about-content">
        <p>Hello, I'm {SITE_AUTHOR}!</p>
        <p>I am a software developer who enjoys sharing knowledge about programming, technology, and software development. With a passion for learning and teaching, {SITE_AUTHOR} creates content that helps others improve their skills and stay up-to-date with the latest trends in the tech industry.</p>
    </div>
</section>

<style>
  section {
    margin: 3rem 0;
    padding: 3rem 2rem;
    background: white;
    border-radius: 16px;
    border: 1px solid rgba(255, 183, 178, 0.2);
    box-shadow: 0 8px 32px rgba(255, 154, 162, 15%);
  }

  h2 {
    margin-bottom: 1.5rem;
    text-align: center;
    color: #ff9aa2;
    position: relative;
    padding-bottom: 1rem;
  }

  h2::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 60px;
    height: 3px;
    /*background: linear-gradient(90deg, #ffb7b2, #ff9aa2);*/
    border-radius: 3px;
  }

  .about-content p {
    margin-bottom: 1.2rem;
    line-height: 1.8;
    text-align: justify;
    text-indent: 2em;
    color: rgb(var(--gray));
    font-size: 1.05em;
  }

  .about-content p:first-letter {
    font-weight: 700;
    color: var(--accent-dark);
  }
</style>